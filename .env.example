# Escape literal `$` characters as `$$` when using Docker Compose env files.

# Required MCP client auth
PERSONAL_CONTEXT_MCP_API_KEY=change-me

# Optional generic aliases
# MCP_API_KEY=change-me
# MCP_API_KEYS=key-one,key-two

# Optional Google Maps enrichment
# GOOGLE_API_KEY=your-google-api-key
# PERSONAL_GOOGLE_API_KEY=your-google-api-key
# GOOGLE_POLL_CRON=0 * * * *

# Optional Home Assistant location polling
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=your-home-assistant-token
# HA_ENTITY_ID=device_tracker.phone
# HA_POLL_INTERVAL_SECONDS=60

# Optional database override. Default state volume uses ./state/data/mcp.db
# DATABASE_URL=sqlite:///data/mcp.db

# Optional endpoint overrides
# PERSONAL_CONTEXT_MCP_PORT=3003
# PERSONAL_CONTEXT_MCP_HOST_PORT=3003
# PERSONAL_CONTEXT_MCP_PATH=/mcp

# Optional runtime tuning
# LOCATION_STALE_HOURS=6
# HOLIDAY_FETCH_TIMEOUT_MS=5000
# DATA_RETENTION_DAYS=90
# DATA_CLEANUP_INTERVAL_SECONDS=3600
# CODE_TTL_SECONDS=90
# TOKEN_TTL_SECONDS=3600
# API_KEY_MODE=disabled
