{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "type": "filesystem",
    "path": "server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "type": "uv",
    "python": ">=3.11",
    "project": "."
  },
  "deployment": {
    "transport": "streamable-http",
    "host": "127.0.0.1",
    "port": 3003,
    "path": "/mcp",
    "log_level": "INFO",
    "env": {
      "DATABASE_URL": "sqlite:///data/mcp.db",
      "PERSONAL_DATABASE_URL": "${PERSONAL_DATABASE_URL}",
      "API_KEY_MODE": "${API_KEY_MODE}",
      "PERSONAL_API_KEY_MODE": "${PERSONAL_API_KEY_MODE}",
      "MASTER_KEY": "${MASTER_KEY}",
      "PERSONAL_MASTER_KEY": "${PERSONAL_MASTER_KEY}",
      "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
      "PERSONAL_GOOGLE_API_KEY": "${PERSONAL_GOOGLE_API_KEY}",
      "GOOGLE_POLL_CRON": "${GOOGLE_POLL_CRON}",
      "PERSONAL_GOOGLE_POLL_CRON": "${PERSONAL_GOOGLE_POLL_CRON}",
      "GOOGLE_HTTP_TIMEOUT_MS": "${GOOGLE_HTTP_TIMEOUT_MS}",
      "PERSONAL_GOOGLE_HTTP_TIMEOUT_MS": "${PERSONAL_GOOGLE_HTTP_TIMEOUT_MS}",
      "HA_URL": "${HA_URL}",
      "HA_TOKEN": "${HA_TOKEN}",
      "HA_ENTITY_ID": "${HA_ENTITY_ID}",
      "HA_TIMEOUT_MS": "${HA_TIMEOUT_MS}",
      "PERSONAL_HA_TIMEOUT_MS": "${PERSONAL_HA_TIMEOUT_MS}",
      "HA_POLL_INTERVAL_SECONDS": "${HA_POLL_INTERVAL_SECONDS}",
      "PERSONAL_HA_POLL_INTERVAL_SECONDS": "${PERSONAL_HA_POLL_INTERVAL_SECONDS}",
      "HA_LOCATION_TTL_SECONDS": "${HA_LOCATION_TTL_SECONDS}",
      "PERSONAL_HA_LOCATION_TTL_SECONDS": "${PERSONAL_HA_LOCATION_TTL_SECONDS}",
      "LOCATION_STALE_HOURS": "6",
      "HOLIDAY_FETCH_TIMEOUT_MS": "5000",
      "DATA_RETENTION_DAYS": "${DATA_RETENTION_DAYS}",
      "PERSONAL_DATA_RETENTION_DAYS": "${PERSONAL_DATA_RETENTION_DAYS}",
      "DATA_CLEANUP_INTERVAL_SECONDS": "${DATA_CLEANUP_INTERVAL_SECONDS}",
      "PERSONAL_DATA_CLEANUP_INTERVAL_SECONDS": "${PERSONAL_DATA_CLEANUP_INTERVAL_SECONDS}",
      "CODE_TTL_SECONDS": "${CODE_TTL_SECONDS}",
      "PERSONAL_CODE_TTL_SECONDS": "${PERSONAL_CODE_TTL_SECONDS}",
      "TOKEN_TTL_SECONDS": "${TOKEN_TTL_SECONDS}",
      "PERSONAL_TOKEN_TTL_SECONDS": "${PERSONAL_TOKEN_TTL_SECONDS}",
      "API_KEY_ISSUE_RATELIMIT": "${API_KEY_ISSUE_RATELIMIT}",
      "PERSONAL_API_KEY_ISSUE_RATELIMIT": "${PERSONAL_API_KEY_ISSUE_RATELIMIT}",
      "API_KEY_ISSUE_WINDOW_SECONDS": "${API_KEY_ISSUE_WINDOW_SECONDS}",
      "PERSONAL_API_KEY_ISSUE_WINDOW_SECONDS": "${PERSONAL_API_KEY_ISSUE_WINDOW_SECONDS}",
      "MCP_RATELIMIT_PER_KEY": "${MCP_RATELIMIT_PER_KEY}",
      "PERSONAL_MCP_RATELIMIT_PER_KEY": "${PERSONAL_MCP_RATELIMIT_PER_KEY}",
      "MCP_RATELIMIT_WINDOW_SECONDS": "${MCP_RATELIMIT_WINDOW_SECONDS}",
      "PERSONAL_MCP_RATELIMIT_WINDOW_SECONDS": "${PERSONAL_MCP_RATELIMIT_WINDOW_SECONDS}",
      "PERSONAL_CONTEXT_MCP_API_KEY": "${PERSONAL_CONTEXT_MCP_API_KEY}",
      "MCP_API_KEY": "${MCP_API_KEY}",
      "MCP_API_KEYS": "${MCP_API_KEYS}",
      "MCP_TRANSPORT": "streamable-http",
      "MCP_HOST": "127.0.0.1",
      "MCP_PORT": "3003",
      "MCP_PATH": "/mcp",
      "FASTMCP_TRANSPORT": "streamable-http",
      "HOST": "127.0.0.1",
      "PORT": "3003"
    }
  }
}
